<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><link rel="stylesheet" href="/styles.css"><title>Admin Dashboard — R TEX BD</title></head><body class="admin-body"><div class="admin-wrap"><aside class="sidebar"><a href="/admin" style="font:600 24px 'Playfair Display';color:#fff">R TEX BD</a><nav><a class="active" href="/admin">Dashboard</a><a href="/admin/products">Products</a><a href="/admin/orders">Orders</a><a href="/admin/content">Reviews</a><a href="/admin/settings">Settings</a><a href="/" target="_blank">View Store ↗</a><a href="#" id="logout">Logout</a></nav></aside><main class="admin-main"><div class="section-head"><div><span class="eyebrow">Store control</span><h1>Dashboard</h1></div></div><div class="stats"><div class="stat"><span class="muted">Products</span><br><b><%=stats.products%></b></div><div class="stat"><span class="muted">Orders</span><br><b><%=stats.orders%></b></div><div class="stat"><span class="muted">Customers</span><br><b><%=stats.customers%></b></div><div class="stat"><span class="muted">Paid revenue</span><br><b>৳<%=Number(stats.revenue).toLocaleString('en-BD')%></b></div></div><section class="section" style="padding:35px 0"><div class="section-head"><div><h2>Recent orders</h2></div><a href="/admin/orders">Manage orders →</a></div><div class="table-wrap"><table class="table"><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th><th>Payment</th><th>Date</th></tr></thead><tbody><%recent.forEach(o=>{%><tr><td><b><%=o.order_number%></b></td><td><%=o.customer_name%><br><small><%=o.phone%></small></td><td>৳<%=Number(o.total).toLocaleString('en-BD')%></td><td><%=o.status%></td><td><%=o.payment_status%></td><td><%=new Date(o.created_at).toLocaleString()%></td></tr><%})%></tbody></table></div></section></main></div><script>document.getElementById('logout').onclick=async e=>{e.preventDefault();await fetch('/api/admin/logout',{method:'POST'});location.href='/admin/login'}</script><script src="/app.js" defer></script></body></html>
