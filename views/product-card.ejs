<a class="product-card" href="/product/<%= p.slug %>"><div class="product-img"><img src="<%= p.image_url || '/logo.jpg' %>" alt="<%= p.name %>" loading="lazy"><% if(p.featured){%><span class="badge">Featured</span><%}%></div><div class="product-info"><h3><%= p.name %></h3><div><span class="price">৳<%= Number(p.price).toLocaleString('en-BD') %></span><% if(p.compare_price){%><span class="old">৳<%= Number(p.compare_price).toLocaleString('en-BD') %></span><%}%></div><div class="swatches"><% [...new Set(p.variants.map(v=>v.color))].slice(0,4).forEach(c=>{%><span class="swatch"><%= c %></span><%}) %></div><small class="muted"><%= p.variants.reduce((n,v)=>n+Number(v.stock),0) %> in stock</small></div></a>
