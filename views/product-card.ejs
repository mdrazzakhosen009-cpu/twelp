<article class="product-card"><a href="/product/<%= p.slug %>"><div class="product-img"><img src="<%= p.image_url || '/assets/logo.jpg' %>" alt="<%= p.name %>" loading="lazy"><% if(p.featured){%><span class="badge">Featured</span><%}%></div><div class="product-info"><h3><%= p.name %></h3><div><span class="price">৳<%= Number(p.price).toLocaleString('en-BD') %></span><% if(p.compare_price){%><span class="old">৳<%= Number(p.compare_price).toLocaleString('en-BD') %></span><%}%></div><div class="swatches"><% [...new Set(p.variants.map(v=>v.color))].slice(0,3).forEach(c=>{%><span class="swatch"><%= c %></span><%}) %><% if(new Set(p.variants.map(v=>v.color)).size>3){%><span class="swatch">+<%=new Set(p.variants.map(v=>v.color)).size-3%></span><%}%></div><small class="muted"><%= p.variants.reduce((n,v)=>n+Number(v.stock),0) %> in stock</small></div></a><% const first=p.variants.find(v=>Number(v.stock)>0)||p.variants[0]; if(first){ %><button class="card-add" data-add='<%- JSON.stringify({productId:p.id,variantId:first.id,name:p.name,price:p.price,size:first.size,color:first.color,image:p.image_url,quantity:1}) %>'>🛒 Add to Cart</button><% } %></article>
