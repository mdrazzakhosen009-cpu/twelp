<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/styles.css"><title>Reviews — R TEX BD Admin</title></head><body class="admin-body"><div class="admin-wrap"><aside class="sidebar"><a href="/admin" class="admin-brand"><img src="/assets/logo.jpg"><span>R TEX BD<small>STORE CONTROL</small></span></a><nav><a href="/admin">Dashboard</a><a href="/admin/products">Products</a><a href="/admin/orders">Orders</a><a class="active" href="/admin/content">Reviews</a><a href="/admin/settings">Settings</a><a href="/" target="_blank">View Store ↗</a><a href="#" id="logout">Logout</a></nav></aside><main class="admin-main"><div class="section-head"><div><span class="eyebrow">Social proof</span><h1>Customer Reviews</h1><p class="muted">Publish store reviews with the customer’s phone model. Published reviews automatically appear in the public side-scrolling carousel.</p></div></div><div class="admin-grid-2"><section class="panel"><h2>Add Review</h2><form id="reviewForm"><div class="field"><label>Product</label><select class="select" name="productId" required><% const productOptions=typeof products!=='undefined'?products:[]; productOptions.forEach(p=>{ %><option value="<%=p.id%>"><%=p.name%></option><% }) %></select></div><div class="form-grid"><div class="field"><label>Customer name</label><input class="input" name="name" required></div><div class="field"><label>Phone model</label><input class="input" name="phoneModel" placeholder="iPhone 15 / Samsung S24"></div></div><div class="field"><label>Rating</label><select class="select" name="rating"><option value="5">★★★★★ — Excellent</option><option value="4">★★★★☆ — Great</option><option value="3">★★★☆☆ — Good</option><option value="2">★★☆☆☆ — Fair</option><option value="1">★☆☆☆☆ — Poor</option></select></div><div class="field"><label>Review</label><textarea class="textarea" name="comment" rows="5" required></textarea></div><label class="check"><input type="checkbox" name="approved" checked> Publish immediately</label><button class="btn btn-primary">Publish Review</button><p id="reviewMsg" class="muted"></p></form></section><section class="panel"><h2>How it works</h2><div class="admin-note"><b>✓ Phone model included</b><span>Every review stores the phone model and shows it publicly.</span></div><div class="admin-note"><b>✓ Admin-controlled publishing</b><span>You can publish or hide any review at any time.</span></div><div class="admin-note"><b>✓ Automatic side scroll</b><span>Public approved reviews continuously move horizontally on the homepage.</span></div></section></div><section class="panel" style="margin-top:18px"><h2>All Reviews</h2><div class="review-admin-list"><% reviews.forEach(r=>{ %><div class="review-admin-row"><div><b><%=r.name%></b><small><%=r.phone_model||'Phone model not provided'%> · <%=r.product_name%></small><span class="stars"><%= '★'.repeat(r.rating) %><%= '☆'.repeat(5-r.rating) %></span><p><%=r.comment%></p></div><label class="switch"><input type="checkbox" data-review="<%=r.id%>" <%=r.approved?'checked':''%>><span></span></label></div><% }) %></div></section></main></div><script>
const form=document.getElementById('reviewForm');form.onsubmit=async e=>{e.preventDefault();const fd=new FormData(form),body=Object.fromEntries(fd);body.approved=fd.get('approved')==='on';const r=await fetch('/api/admin/reviews',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}),d=await r.json();document.getElementById('reviewMsg').textContent=d.message||d.error||'Done';if(r.ok){form.reset();form.approved.checked=true;setTimeout(()=>location.reload(),500)}};
document.querySelectorAll('[data-review]').forEach(x=>x.onchange=async()=>{const r=await fetch('/api/admin/reviews/'+x.dataset.review,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({approved:x.checked})});if(!r.ok){x.checked=!x.checked;alert('Could not update review')}});document.getElementById('logout').onclick=async e=>{e.preventDefault();await fetch('/api/admin/logout',{method:'POST'});location.href='/admin/login'};
</script><script src="/app.js" defer></script></body></html>
