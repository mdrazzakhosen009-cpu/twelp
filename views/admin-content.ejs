<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/styles.css"><title>Reviews — R TEX BD Admin</title></head><body><div class="admin-wrap"><aside class="sidebar"><a href="/admin" style="font:600 24px 'Playfair Display';color:#fff">R TEX BD</a><nav><a href="/admin">Dashboard</a><a href="/admin/products">Products</a><a href="/admin/orders">Orders</a><a class="active" href="/admin/content">Reviews</a><a href="/admin/settings">Settings</a><a href="/" target="_blank">View Store ↗</a><a href="#" id="logout">Logout</a></nav></aside><main class="admin-main"><div class="section-head"><div><span class="eyebrow">Social proof</span><h1>Reviews</h1></div></div><div class="panel"><%if(reviews.length){reviews.forEach(r=>{%><div style="padding:17px 0;border-bottom:1px solid var(--line)"><div><span class="stars"><%= '★'.repeat(r.rating) %></span> <b><%=r.name%></b> <small class="muted"><%=r.phone_model%> · <%=r.product_name%></small></div><p class="muted">“<%=r.comment%>”</p><button class="btn <%=r.approved?'btn-light':'btn-primary'%>" data-review="<%=r.id%>" data-approved="<%=r.approved?0:1%>"><%=r.approved?'Unpublish':'Approve'%></button></div><%})}else{%><div class="empty">No reviews yet.</div><%}%></div></main></div><script>document.querySelectorAll('[data-review]').forEach(b=>b.onclick=async()=>{const r=await fetch('/api/admin/reviews/'+b.dataset.review,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({approved:b.dataset.approved==='1'})});if(r.ok)location.reload()});document.getElementById('logout').onclick=async e=>{e.preventDefault();await fetch('/api/admin/logout',{method:'POST'});location.href='/admin/login'}</script></body></html>
