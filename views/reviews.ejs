<%- include('header',{title:'Customer Reviews — '+settings.store_name}) %><section class="page-head"><div class="container"><span class="eyebrow">Real customer voice</span><h1>What Our Customers Say</h1><p class="muted">Reviews published by the store and approved customer feedback.</p></div></section><section class="section" style="padding-top:5px"><div class="container"><div class="review-grid"><% reviews.forEach(r=>{ %><article class="review-card"><div class="review-top"><div class="avatar phone-avatar" title="Phone model">📱</div><div><b><%=r.name%></b><small><%=r.phone_model||'Verified customer'%></small></div><span>♡</span></div><div class="stars"><%= '★'.repeat(r.rating) %><%= '☆'.repeat(5-r.rating) %></div><p>“<%=r.comment%>”</p><small class="review-product"><%=r.product_name%></small></article><% }) %></div></div></section><%- include('footer') %>
