<%- include('header',{title:settings.store_name+' — Premium Three-Piece Collection'}) %>
<section class="hero"><div class="container hero-grid"><div><span class="eyebrow">R TEX BD · Women’s Three-Piece</span><h1><%= settings.hero_title %></h1><p><%= settings.hero_subtitle %></p><div class="hero-actions"><a class="btn btn-primary" href="/shop">Explore Collection →</a><a class="btn btn-light" href="https://wa.me/<%= settings.whatsapp %>" target="_blank" rel="noopener">Chat on WhatsApp</a></div><div class="trust"><div><b>Premium Feel</b><span>Curated women’s collections</span></div><div><b>Easy Ordering</b><span>Simple checkout & order number</span></div><div><b>Nationwide</b><span>Delivery across Bangladesh</span></div></div></div><div class="hero-art"><img src="/logo.jpg" alt="R TEX BD premium three-piece brand logo"></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Shop by style</span><h2>Collections</h2></div><a href="/shop">View all →</a></div><div class="category-row"><% categories.forEach(c=>{ %><a class="category" href="/shop?category=<%= c.slug %>"><b><%= c.name %></b><span class="muted">Explore collection →</span></a><% }) %></div></div></section>
<section class="section" style="padding-top:15px"><div class="container"><div class="section-head"><div><span class="eyebrow">Handpicked</span><h2>Featured Pieces</h2></div><a href="/shop">Shop collection →</a></div><div class="grid"><% (featured.length?featured:products).forEach(p=>{ %><%- include('product-card',{p}) %><% }) %></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Real customer voice</span><h2>Reviews</h2></div></div><div class="review-strip" id="reviewStrip"><% if(reviews.length){ reviews.forEach(r=>{ %><article class="review"><div class="stars"><%= '★'.repeat(r.rating) %><%= '☆'.repeat(5-r.rating) %></div><b><%= r.name %></b><small class="muted"> · <%= r.phone_model || 'Verified customer' %></small><p>“<%= r.comment %>”</p><small class="muted"><%= r.product_name %></small></article><% })}else{%><div class="empty" style="min-width:100%">Customer reviews will appear here after approval from the Admin Panel.</div><% } %></div></div></section>
<script>setInterval(()=>{const x=document.getElementById('reviewStrip');if(x&&x.scrollWidth>x.clientWidth)x.scrollBy({left:330,behavior:'smooth'});},4200)</script>
<%- include('footer') %>
