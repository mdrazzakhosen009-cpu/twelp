<%- include('header',{title:settings.store_name+' — Premium Three-Piece Collection'}) %>
<section class="hero-ref"><div class="hero-bg"></div><div class="container hero-content"><div class="hero-copy"><span class="script">Elegant Style</span><h1>FOR EVERY MOMENT</h1><p>Premium Three Piece Collection<br>for the Modern You</p><a class="btn btn-primary" href="/shop">Shop Now →</a></div><div class="hero-model"><img src="/assets/hero-fashion.jpg" alt="Premium three piece fashion"></div><div class="hero-trust"><div><i>◇</i><b>Premium Quality</b><small>Best Fabric & Finish</small></div><div><i>▣</i><b>Fast Delivery</b><small>All Over Bangladesh</small></div><div><i>♡</i><b>Secure Payment</b><small>100% Safe & Trusted</small></div></div></div></section>
<section class="section compact"><div class="container category-section"><div class="category-title"><h2>Shop by Category</h2><p>Find your perfect style</p><em></em></div><div class="category-circles"><% categories.forEach(c=>{ %><a class="cat-circle" href="/shop?category=<%= c.slug %>"><img src="<%= c.image_url || '/assets/logo.jpg' %>" alt="<%= c.name %>"><span><%= c.name %></span></a><% }) %></div></div></section>
<section class="section featured-ref"><div class="container"><div class="ref-head"><div><h2>Featured Products</h2><p>Best Selling & Trending</p></div><a href="/shop">View All Products →</a></div><div class="featured-layout"><div class="grid ref-products"><% (featured.length?featured:products).slice(0,4).forEach(p=>{ %><%- include('product-card',{p}) %><% }) %></div><div class="promo-stack"><a class="promo promo-green" href="/shop"><div><span>New Collection</span><small>Stylish · Comfortable · Elegant</small><b>Shop Now →</b></div><img src="/assets/demo-product-2.jpg" alt="New collection"></a><a class="promo promo-pink" href="/shop"><div><span>Special Offer</span><small>UP TO 20% OFF<br>On Selected Products</small><b>Shop Now →</b></div><img src="/assets/demo-product-3.jpg" alt="Special offer"></a></div></div></div></section>
<section class="section reviews-ref"><div class="container"><div class="ref-head"><div><h2>What Our Customers Say</h2><p>Real Reviews from Real People</p></div></div><div class="review-carousel" data-review-carousel><div class="review-track"><% if(reviews.length){ reviews.forEach(r=>{ %><article class="review-card"><div class="review-top"><div class="avatar phone-avatar" title="Phone model">📱</div><div><b><%= r.name %></b><small><%= r.phone_model || 'Verified customer' %></small></div><span>♡</span></div><div class="stars"><%= '★'.repeat(r.rating) %><%= '☆'.repeat(5-r.rating) %></div><p>“<%= r.comment %>”</p><small class="review-product"><%= r.product_name %></small></article><% })} else { %><div class="empty">Customer reviews will appear here after approval.</div><% } %></div></div></div></section>
<div class="bottom-benefits"><div>♡ <b>100% Original Products</b><small>Guaranteed Quality</small></div><div>▱ <b>Cash on Delivery</b><small>Pay After Receive</small></div><div>↻ <b>Easy Return</b><small>Within 7 Days</small></div><div>♧ <b>24/7 Support</b><small>We’re Here to Help</small></div></div>
<%- include('footer') %>
