<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/styles.css"><title>Orders — R TEX BD Admin</title></head><body class="admin-body"><div class="admin-wrap"><aside class="sidebar"><a href="/admin" style="font:600 24px 'Playfair Display';color:#fff">R TEX BD</a><nav><a href="/admin">Dashboard</a><a href="/admin/products">Products</a><a class="active" href="/admin/orders">Orders</a><a href="/admin/content">Reviews</a><a href="/admin/settings">Settings</a><a href="/" target="_blank">View Store ↗</a><a href="#" id="logout">Logout</a></nav></aside><main class="admin-main"><div class="section-head"><div><span class="eyebrow">Fulfilment</span><h1>Orders</h1></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Order</th><th>Customer</th><th>Amount</th><th>Status</th><th>Payment</th><th>Created</th></tr></thead><tbody><%orders.forEach(o=>{%><tr><td><b><%=o.order_number%></b><br><small><%=o.address%></small></td><td><%=o.customer_name%><br><a href="tel:<%=o.phone%>"><%=o.phone%></a></td><td>৳<%=Number(o.total).toLocaleString('en-BD')%></td><td><select class="select" data-status="<%=o.id%>"><%['pending','confirmed','processing','shipped','delivered','cancelled'].forEach(s=>{%><option <%=o.status===s?'selected':''%>><%=s%></option><%})%></select></td><td><select class="select" data-payment="<%=o.id%>"><%['unpaid','paid','failed','refunded'].forEach(s=>{%><option <%=o.payment_status===s?'selected':''%>><%=s%></option><%})%></select></td><td><%=new Date(o.created_at).toLocaleString()%></td></tr><%})%></tbody></table></div></main></div><script>async function save(id){const status=document.querySelector(`[data-status="${id}"]`).value,paymentStatus=document.querySelector(`[data-payment="${id}"]`).value;const r=await fetch('/api/admin/orders/'+id,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({status,paymentStatus})});if(r.ok)toast('Order updated',true);else toast('Update failed')}document.querySelectorAll('[data-status]').forEach(x=>x.onchange=()=>save(x.dataset.status));document.querySelectorAll('[data-payment]').forEach(x=>x.onchange=()=>save(x.dataset.payment));document.getElementById('logout').onclick=async e=>{e.preventDefault();await fetch('/api/admin/logout',{method:'POST'});location.href='/admin/login'};function toast(m){alert(m)}</script><script src="/app.js" defer></script></body></html>
