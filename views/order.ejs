<%- include('header',{title:'Order '+order.order_number+' — '+settings.store_name}) %><section class="section"><div class="container" style="max-width:850px"><div class="panel"><span class="eyebrow">Order confirmed</span><h1 style="font:600 48px 'Playfair Display'">Thank you for your order.</h1><p class="muted">Order number: <b style="color:var(--ink)"><%=order.order_number%></b></p><div class="notice success">Status: <b><%=order.status%></b> · Payment: <b><%=order.payment_status%></b></div><%items.forEach(i=>{%><div class="cart-row"><div></div><div><b><%=i.product_name%></b><div class="muted"><%=i.size%> · <%=i.color%> · Qty <%=i.quantity%></div></div><b>৳<%=Number(i.line_total).toLocaleString('en-BD')%></b></div><%})%><div class="summary-line"><span>Subtotal</span><b>৳<%=Number(order.subtotal).toLocaleString('en-BD')%></b></div><div class="summary-line"><span>Delivery</span><b>৳<%=Number(order.delivery_fee).toLocaleString('en-BD')%></b></div><div class="summary-line total"><span>Total</span><b>৳<%=Number(order.total).toLocaleString('en-BD')%></b></div><div style="margin-top:20px;display:flex;gap:10px;flex-wrap:wrap"><a class="btn btn-primary" href="https://wa.me/<%=settings.whatsapp%>?text=My%20R%20TEX%20BD%20order%20is%20<%=encodeURIComponent(order.order_number)%>" target="_blank" rel="noopener">Contact on WhatsApp</a><a class="btn btn-light" href="/shop">Continue Shopping</a></div></div></div></section><%- include('footer') %>
