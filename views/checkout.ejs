<%- include('header',{title:'Checkout — '+settings.store_name}) %><section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Secure order</span><h2>Checkout</h2></div></div><div class="checkout-grid"><div class="panel"><div data-cart-root></div></div><div class="panel"><h3>Delivery details</h3><form data-checkout><div class="field"><label>Full name</label><input class="input" name="customerName" required></div><div class="field"><label>Phone number</label><input class="input" name="phone" inputmode="tel" required placeholder="01XXXXXXXXX"></div><div class="form-grid"><div class="field"><label>Area</label><input class="input" name="area" placeholder="Area / Thana"></div><div class="field"><label>Delivery</label><select class="select" name="deliveryZone"><option value="inside">Inside delivery area — ৳<%=settings.delivery_inside%></option><option value="outside">Outside delivery area — ৳<%=settings.delivery_outside%></option></select></div></div><div class="field"><label>Full address</label><textarea class="textarea" name="address" rows="4" required></textarea></div><div class="field"><label>Order note (optional)</label><textarea class="textarea" name="note" rows="3"></textarea></div><div data-summary></div><button class="btn btn-primary" type="submit" style="width:100%;margin-top:12px">Place Order</button><small class="muted" style="display:block;margin-top:10px">Payment status is recorded by the order system. Cash on delivery can be confirmed by the store.</small></form></div></div></div></section><%- include('footer') %>
