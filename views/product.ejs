<%- include('header',{title:product.name+' — '+settings.store_name}) %><section class="section"><div class="container"><div class="product-detail"><div class="product-gallery"><img src="<%= product.image_url||'/assets/logo.jpg' %>" alt="<%= product.name %>"></div><div><span class="eyebrow"><%= product.category_name||'Collection' %></span><h1 style="font:600 50px 'Playfair Display';margin:12px 0"><%= product.name %></h1><div><span class="price" style="font-size:25px">৳<%= Number(product.price).toLocaleString('en-BD') %></span><%if(product.compare_price){%><span class="old">৳<%= Number(product.compare_price).toLocaleString('en-BD') %></span><%}%></div><p class="muted" style="line-height:1.8"><%= product.description %></p><div class="field"><label>Size</label><div class="option-row" data-options="size"><% [...new Set(product.variants.map(v=>v.size))].forEach((s,i)=>{%><button type="button" class="option <%=i===0?'selected':''%>" data-size="<%= s %>"><%= s %></button><%})%></div></div><div class="field"><label>Color</label><div class="option-row" data-options="color"><% [...new Set(product.variants.map(v=>v.color))].forEach((c,i)=>{%><button type="button" class="option <%=i===0?'selected':''%>" data-color="<%= c %>"><%= c %></button><%})%></div></div><div class="notice" id="stockNotice">Select your preferred size and color.</div><div style="display:flex;gap:10px;flex-wrap:wrap"><button class="btn btn-primary" id="addProduct">Add to Cart</button><a class="btn btn-light" href="/checkout">View Cart</a></div><div style="margin-top:28px;padding-top:22px;border-top:1px solid var(--line)"><b>Details</b><ul class="muted" style="line-height:1.9"><li>Women’s three-piece collection</li><li>Size and color availability is live from stock</li><li>Delivery charge is shown at checkout</li></ul></div></div></div></div></section><section class="section" style="padding-top:10px"><div class="container"><div class="section-head"><div><span class="eyebrow">Customer feedback</span><h2>Reviews</h2></div></div><div class="review-strip"><%if(reviews.length){reviews.forEach(r=>{%><article class="review"><div class="stars"><%= '★'.repeat(r.rating) %><%= '☆'.repeat(5-r.rating) %></div><b><%=r.name%></b><small class="muted"> · <%=r.phone_model||'Customer'%></small><p>“<%=r.comment%>”</p></article><%})}else{%><div class="empty">No approved reviews yet.</div><%}%></div><div class="panel" style="margin-top:22px;max-width:650px"><h3>Write a review</h3><form data-review-form><input type="hidden" name="productId" value="<%=product.id%>"><div class="form-grid"><div class="field"><label>Your name</label><input class="input" name="name" required></div><div class="field"><label>Phone model</label><input class="input" name="phoneModel" placeholder="e.g. iPhone 15, Samsung S24"></div></div><div class="field"><label>Rating</label><select class="select" name="rating"><option value="5">5 — Excellent</option><option value="4">4 — Great</option><option value="3">3 — Good</option><option value="2">2 — Fair</option><option value="1">1 — Poor</option></select></div><div class="field"><label>Your review</label><textarea class="textarea" name="comment" rows="4" required></textarea></div><button class="btn btn-primary">Submit Review</button></form></div></div></section><script>const variants=<%-JSON.stringify(product.variants)%>;let selectedSize=document.querySelector('[data-size]')?.dataset.size||'',selectedColor=document.querySelector('[data-color]')?.dataset.color||'';function sync(){const v=variants.find(x=>x.size===selectedSize&&x.color===selectedColor);const n=document.getElementById('stockNotice');n.textContent=v?`Available stock: ${v.stock}`:'This size/color combination is not available.';window.currentVariant=v}document.querySelectorAll('[data-size]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-size]').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');selectedSize=b.dataset.size;sync()});document.querySelectorAll('[data-color]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-color]').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');selectedColor=b.dataset.color;sync()});sync();document.getElementById('addProduct').onclick=()=>{const v=window.currentVariant;if(!v)return toast('Please select an available size and color');if(v.stock<1)return toast('This variant is out of stock');Cart.add({productId:<%=product.id%>,variantId:v.id,name:<%-JSON.stringify(product.name)%>,price:<%=product.price%>,size:v.size,color:v.color,image:<%-JSON.stringify(product.image_url||'/assets/logo.jpg')%>,quantity:1})}</script><%- include('footer') %>
