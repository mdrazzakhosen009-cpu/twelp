<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/styles.css"><title>Products — R TEX BD Admin</title></head><body><div class="admin-wrap"><aside class="sidebar"><a href="/admin" style="font:600 24px 'Playfair Display';color:#fff">R TEX BD</a><nav><a href="/admin">Dashboard</a><a class="active" href="/admin/products">Products</a><a href="/admin/orders">Orders</a><a href="/admin/content">Reviews</a><a href="/admin/settings">Settings</a><a href="/" target="_blank">View Store ↗</a><a href="#" id="logout">Logout</a></nav></aside><main class="admin-main"><div class="section-head"><div><span class="eyebrow">Catalog</span><h1>Products</h1></div><button class="btn btn-primary" id="newProduct">+ Add Product</button></div><div class="panel" style="margin-bottom:18px"><form id="catForm" style="display:flex;gap:10px"><input class="input" name="name" placeholder="New category name" required><input class="input" style="max-width:120px" name="sortOrder" type="number" value="0"><button class="btn btn-light">Add Category</button></form></div><div class="panel"><%products.forEach(p=>{%><div class="admin-product" style="padding:10px 0;border-bottom:1px solid var(--line)"><img src="<%=p.image_url||'/logo.jpg'%>" alt=""><div><b><%=p.name%></b><div class="muted">৳<%=Number(p.price).toLocaleString('en-BD')%> · <%=p.category_name||'No category'%> · <%=p.active?'Published':'Hidden'%></div></div><div style="display:flex;gap:6px"><button class="btn btn-light" data-edit='<%-JSON.stringify(p)%>'>Edit</button><button class="btn btn-danger" data-delete="<%=p.id%>">Hide</button></div></div><%})%></div></main></div><div class="drawer" id="drawer"><div class="drawer-card"><button class="iconbtn drawer-close" id="close">×</button><h2 style="font:600 34px 'Playfair Display'" id="formTitle">Add product</h2><form id="productForm" enctype="multipart/form-data"><input type="hidden" name="id"><div class="field"><label>Product name</label><input class="input" name="name" required></div><div class="field"><label>Category</label><select class="select" name="categoryId" required><%categories.forEach(c=>{%><option value="<%=c.id%>"><%=c.name%></option><%})%></select></div><div class="form-grid"><div class="field"><label>Price (BDT)</label><input class="input" name="price" type="number" min="0" required></div><div class="field"><label>Compare price</label><input class="input" name="comparePrice" type="number" min="0"></div></div><div class="field"><label>Description</label><textarea class="textarea" name="description" rows="5"></textarea></div><div class="field"><label>Sizes (comma separated)</label><input class="input" name="sizes" value="Free Size"></div><div class="field"><label>Colors (comma separated)</label><input class="input" name="colors" value="Default"></div><div class="field"><label>Stocks — one number per size×color combination</label><input class="input" name="stocks" value="10"></div><div class="field"><label>Product image (max 5MB)</label><input class="input" name="image" type="file" accept="image/jpeg,image/png,image/webp,image/gif"></div><label style="display:flex;gap:8px;align-items:center;margin:12px 0"><input type="checkbox" name="featured"> Featured</label><label style="display:flex;gap:8px;align-items:center;margin:12px 0"><input type="checkbox" name="active" checked> Published</label><button class="btn btn-primary" style="width:100%">Save Product</button><p id="pm" class="muted"></p></form></div></div><script>
const drawer=document.getElementById('drawer'),form=document.getElementById('productForm');document.getElementById('newProduct').onclick=()=>{form.reset();form.id.value='';form.active.checked=true;document.getElementById('formTitle').textContent='Add product';drawer.classList.add('open')};document.getElementById('close').onclick=()=>drawer.classList.remove('open');drawer.addEventListener('click',e=>{if(e.target===drawer)drawer.classList.remove('open')});
function fill(p){form.id.value=p.id;form.name.value=p.name;form.categoryId.value=p.category_id;form.price.value=p.price;form.comparePrice.value=p.compare_price||'';form.description.value=p.description||'';form.sizes.value=[...new Set(p.variants.map(v=>v.size))].join(', ');form.colors.value=[...new Set(p.variants.map(v=>v.color))].join(', ');form.stocks.value=p.variants.map(v=>v.stock).join(', ');form.featured.checked=!!p.featured;form.active.checked=!!p.active;document.getElementById('formTitle').textContent='Edit product';drawer.classList.add('open')}
document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>fill(JSON.parse(b.dataset.edit)));document.querySelectorAll('[data-delete]').forEach(b=>b.onclick=async()=>{if(!confirm('Hide this product?'))return;const r=await fetch('/api/admin/products/'+b.dataset.delete,{method:'DELETE'});if(r.ok)location.reload()});form.onsubmit=async e=>{e.preventDefault();const fd=new FormData(form);fd.set('featured',form.featured.checked?'1':'0');fd.set('active',form.active.checked?'1':'0');const id=form.id.value;const r=await fetch(id?'/api/admin/products/'+id:'/api/admin/products',{method:id?'PUT':'POST',body:fd});const d=await r.json();if(r.ok)location.reload();else document.getElementById('pm').textContent=d.error||'Could not save'};document.getElementById('catForm').onsubmit=async e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target));const r=await fetch('/api/admin/categories',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});if(r.ok)location.reload();else alert((await r.json()).error)};document.getElementById('logout').onclick=async e=>{e.preventDefault();await fetch('/api/admin/logout',{method:'POST'});location.href='/admin/login'};
</script></body></html>
