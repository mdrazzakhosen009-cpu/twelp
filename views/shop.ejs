<%- include('header',{title:'Collection — '+settings.store_name}) %><section class="page-head"><div class="container"><span class="eyebrow">The collection</span><h1 style="font:600 50px 'Playfair Display';margin:10px 0">Three-Piece Edit</h1><p class="muted">Premium women’s three-piece styles, with selectable sizes and colors.</p><form class="filters" method="get"><input class="input" style="max-width:330px" name="q" value="<%= query %>" placeholder="Search collection…"><select class="select" style="max-width:240px" name="category"><option value="">All categories</option><% categories.forEach(c=>{%><option value="<%= c.slug %>" <%= selectedCategory===c.slug?'selected':'' %>><%= c.name %></option><%})%></select><select class="select" style="max-width:220px" name="sort"><option value="newest">Newest</option><option value="price_asc">Price: Low to high</option><option value="price_desc">Price: High to low</option></select><button class="btn btn-primary">Search</button></form><div class="grid"><% if(products.length){products.forEach(p=>{ %><%- include('product-card',{p}) %><% })}else{%><div class="empty" style="grid-column:1/-1">No matching products found.</div><%}%></div></div></section><%- include('footer') %>
