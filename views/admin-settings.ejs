<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/styles.css"><title>Settings — R TEX BD Admin</title></head><body class="admin-body"><div class="admin-wrap"><aside class="sidebar"><a href="/admin" style="font:600 24px 'Playfair Display';color:#fff">R TEX BD</a><nav><a href="/admin">Dashboard</a><a href="/admin/products">Products</a><a href="/admin/orders">Orders</a><a href="/admin/content">Reviews</a><a class="active" href="/admin/settings">Settings</a><a href="/" target="_blank">View Store ↗</a><a href="#" id="logout">Logout</a></nav></aside><main class="admin-main"><div class="section-head"><div><span class="eyebrow">Brand & operations</span><h1>Settings</h1></div></div><div class="panel"><form id="settings"><div class="form-grid"><%['store_name','tagline','phone','whatsapp','email','address','delivery_inside','delivery_outside'].forEach(k=>{%><div class="field"><label><%=k.replaceAll('_',' ')%></label><input class="input" name="<%=k%>" value="<%=settings[k]||''%>"></div><%})%></div><div class="field"><label>Hero title</label><input class="input" name="hero_title" value="<%=settings.hero_title%>"></div><div class="field"><label>Hero subtitle</label><textarea class="textarea" name="hero_subtitle"><%=settings.hero_subtitle%></textarea></div><div class="field"><label>About</label><textarea class="textarea" name="about" rows="5"><%=settings.about%></textarea></div><div class="field"><label>Footer note</label><input class="input" name="footer_note" value="<%=settings.footer_note%>"></div><button class="btn btn-primary">Save settings</button><p id="msg" class="muted"></p></form></div></main></div><script>document.getElementById('settings').onsubmit=async e=>{e.preventDefault();const r=await fetch('/api/admin/settings',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(e.target)))}),d=await r.json();document.getElementById('msg').textContent=r.ok?'Saved successfully':d.error||'Save failed'};document.getElementById('logout').onclick=async e=>{e.preventDefault();await fetch('/api/admin/logout',{method:'POST'});location.href='/admin/login'}</script><script src="/app.js" defer></script></body></html>
