<%- include('header',{title:'Contact — '+settings.store_name}) %><section class="section"><div class="container" style="max-width:850px"><span class="eyebrow">We’re here to help</span><h1 style="font:600 60px 'Playfair Display'">Contact us</h1><div class="grid" style="grid-template-columns:repeat(2,1fr);margin-top:28px"><div class="panel"><h3>WhatsApp</h3><p class="muted">Fastest way to reach us.</p><a class="btn btn-primary" href="https://wa.me/<%=settings.whatsapp%>" target="_blank" rel="noopener">WhatsApp <%=settings.phone%></a></div><div class="panel"><h3>Address</h3><p class="muted"><%=settings.address%></p><%if(settings.email){%><p><a href="mailto:<%=settings.email%>"><%=settings.email%></a></p><%}%></div></div></div></section><%- include('footer') %>
